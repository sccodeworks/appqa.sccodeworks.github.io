<configuration>
  <system.webServer>
    
    <!-- indicates that the server.js file is a node.js application 
    to be handled by the iisnode module -->
    
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
      <!-- Serve static files directly without iisnode -->
      <add name="StaticFileHandler" path="sitemap.xml" verb="*" modules="StaticFile" resourceType="File" />
      <add name="RobotsFileHandler" path="robots.txt" verb="*" modules="StaticFile" resourceType="File" />
    </handlers>
    
    <!-- Add MIME types for .xml files if not already present -->
    <staticContent>
      <mimeMap fileExtension=".xml" mimeType="application/xml" />
    </staticContent>
    
    <!-- adds index.js to the default document list to allow 
    URLs that only specify the application root location, 
    e.g. http://mysite.antarescloud.com/ -->
    
    <defaultDocument enabled="true">
      <files>
        <add value="server.js" />
      </files>
    </defaultDocument> 
      <httpErrors existingResponse="PassThrough" />

    <!-- Ensure the Node.js application can handle all URLs -->
    <rewrite>
      <rules>
        <!-- Exclude sitemap.xml and robots.txt from Node.js routing -->
        <rule name="StaticFiles" stopProcessing="true">
          <match url="^(sitemap\.xml|robots\.txt)$" />
          <action type="None" />
        </rule>
        <rule name="NodeJS" stopProcessing="true">
          <match url="/*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    
  </system.webServer>
</configuration>